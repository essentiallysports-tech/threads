{
  "name": "es-threads-temporal",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic replacement for the ES Threads Automation prose skill file — real code (Temporal workflows/activities) instead of an AI Routine following instructions.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "run-once": "ts-node src/client.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "ai": "^5.0.0",
    "@ai-sdk/xai": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0"
  }
}

# Copy to .env.local for local dev, or to /etc/es-threads-temporal.env on the
# EC2 worker host. Never commit the real file.

TEMPORAL_API_KEY=
TEMPORAL_NAMESPACE=es-threads.eays8
TEMPORAL_ADDRESS=es-threads.eays8.tmprl.cloud:7233

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=essentiallysports-images-v2prod

BEEHIIV_API_KEY=
POSTIZ_API_KEY=

# Render pipeline, all called directly by this worker (no ES-MCP in between
# as of 2026-09-07 — see lib/esDirect.ts's header comment for why and what
# replaced it): Typesense image search -> Cloudinary crop -> Orshot render.
# See README "Render pipeline" for how each was obtained.
ORSHOT_API_KEY=
# Same Typesense project ES-MCP's own search_images tool used — this worker
# now calls Typesense directly instead of going through that server.
TYPESENSE_SEARCH_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Article sourcing — the ES WordPress REST API, called directly. Replaces
# ES-MCP's Athena-backed query_articles tool as of 2026-09-07. No key
# needed: wp-json/wp/v2/posts is a public, unauthenticated endpoint. See
# lib/esDirect.ts for why the endpoint is staging.essentiallysports.com
# and not www (production's own wp-json redirects there).

# GEMINI_API_KEY=              # optional legacy fallback (lib/gemini.ts), not the current render path
LIVE_POSTING=false             # keep false until the dry-run comparison period is done

# Internal web-search-microservice (github.com/essentiallysports-tech/web-search-microservice)
# — primary tier for lib/webSearch.ts's sourcing + fact-check calls (replacing
# direct Vercel-AI-Gateway-billed generateText() tool-use calls) AND
# lib/socialSearch.ts's Twitter/Reddit sourcing (replacing Apify). Unset means
# both files fall straight through to their old paths unchanged — see
# webSearch.ts's 2026-09-03 and socialSearch.ts's 2026-09-04 OPERATOR FIX
# comments.
WEB_SEARCH_MICROSERVICE_URL=
WEB_SEARCH_MICROSERVICE_API_KEY=
